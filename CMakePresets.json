{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "debug-asan",
      "inherits": "base",
      "displayName": "Debug + AddressSanitizer + UBSan (used for all tests)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ALGO_SANITIZE": "ON",
        "ALGO_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release -O3 (benchmarks; tests also run)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ALGO_SANITIZE": "OFF",
        "ALGO_BUILD_BENCH": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug-asan", "configurePreset": "debug-asan" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "debug-asan",
      "configurePreset": "debug-asan",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    }
  ]
}
